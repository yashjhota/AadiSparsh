# ==========================================
# Aadi Sparsh — Environment Configuration
# ==========================================

# Public Supabase credentials for client-side queries (safe in browser)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Privileged Supabase Service Role Key:
# STRICT SECURITY WARNING: Used ONLY for backend seed scripts and administrative migration tasks.
# NEVER expose this key in frontend client bundles or browser code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Node/Express server port (default 3000 for AI Studio environment)
PORT=3000

# Application hosting URL
APP_URL="http://localhost:3000"
